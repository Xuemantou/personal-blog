# 管理员 Token（用于文章编写鉴权，建议使用随机强密码）
ADMIN_TOKEN=your-secret-token-here

# Giscus 配置
# 访问 https://giscus.app 获取以下配置信息

# GitHub 仓库 (格式: owner/repo)
NEXT_PUBLIC_GISCUS_REPO=your-org/your-repo

# 仓库 ID (在 giscus.app 生成)
NEXT_PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxxxxx

# Discussion 分类名称
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements

# 分类 ID (在 giscus.app 生成)
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxxxx
